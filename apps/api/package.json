{
  "name": "@metaclaude/api",
  "version": "0.52.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:e2e": "node scripts/e2e.mjs",
    "check:browser": "node scripts/browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@huggingface/transformers": "4.2.0",
    "@metaclaude/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
