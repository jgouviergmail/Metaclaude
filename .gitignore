node_modules/
dist/
build/
*.tsbuildinfo
# tsc must never emit next to the sources; if it does, don't commit it.
apps/web/src/**/*.js
apps/web/src/**/*.js.map
apps/web/vite.config.js
apps/web/vite.config.js.map
.vite/
coverage/

# Runtime data — never commit
data/
workspaces/
*.db
*.db-shm
*.db-wal
*.sqlite

# Secrets
# Certificates and keys mounted into the proxy, never committed.
docker/certs/*
!docker/certs/.gitkeep
*.pem
*.key
!apps/**/*.key
.env
.env.local
.env.*.local
secrets/
caddy_data/
caddy_config/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
