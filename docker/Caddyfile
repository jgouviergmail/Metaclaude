# Caddy — TLS termination and the only public entry point.
#
# ── Why TLS is not optional here ──────────────────────────────────────────────
#
# Metaclaude sets a Secure session cookie and installs a service worker. Both
# require a *secure context*: over plain HTTP the browser refuses to store the
# cookie and refuses to register the worker, so the app does not merely become
# less safe — it stops working. There is no "just use HTTP for now" mode.
#
# ── Choosing how the certificate is obtained ──────────────────────────────────
#
# Two variables, and nothing else changes between deployments:
#
#   METACLAUDE_SITE       the address browsers use — an IP, or a hostname
#   METACLAUDE_TLS_MODE   which docker/tls/<mode>.caddy is mounted here
#
# The four modes, each documented in its own file:
#
#   internal   Caddy's own CA. Works with nothing but an IP and no third party.
#              Install the root once per device or every visit warns.
#   acme-dns   Public Let's Encrypt for a hostname that resolves here.
#   acme-ip    Public Let's Encrypt for the bare IP itself. Real certificate,
#              nothing to install — but 160-hour lifetimes and a hard 5-per-week
#              issuance ceiling, so renewal has to actually work.
#   file       A certificate from elsewhere. The Tailscale route: a real
#              hostname and a real certificate without owning a domain, and no
#              inbound ports at all.
#
# See docs/DEPLOYMENT.md for which to pick.
{
	# `internal` is not an email address, so this is only consulted in ACME mode.
	# Caddy ignores it otherwise.
	email {$METACLAUDE_TLS_EMAIL:internal}

	# Which certificate to serve when the client sends no SNI at all.
	#
	# RFC 6066 forbids IP literals in SNI, so *every* browser reaching this
	# server by address rather than by name sends none. Caddy then falls back to
	# the connection's local address to choose a certificate — which works when
	# Caddy owns the address, and does not here: behind Docker's published ports
	# the local address is the container's (172.x.y.z), and no certificate covers
	# that. The handshake dies before any log line:
	#
	#     curl: (35) ... error:0A000438:SSL routines::tlsv1 alert internal error
	#
	# So the IP modes were unusable from a browser, and only requests that
	# happened to send SNI — Docker's own healthcheck among them — got through.
	# Naming the site closes it: the emitted policy then matches `sni: ["", …]`,
	# and the empty string is precisely the no-SNI case.
	#
	# Its own variable rather than METACLAUDE_SITE, because the two answer
	# different questions. METACLAUDE_SITE is the address the owner types; this
	# is the address a client that sent no SNI must have dialled — and a client
	# sends no SNI precisely when it dialled an IP. Once a domain is in play the
	# two diverge: the site is the name, and the no-SNI client is on the address.
	# bootstrap.sh sets this to the host's own IP in both cases.
	default_sni {$METACLAUDE_SNI_DEFAULT:localhost}

	# And which certificate to serve when the client sends an SNI that matches
	# nothing. `default_sni` does not cover this: it applies only to an *empty*
	# SNI, so a client that names something unknown still gets alert 80 and no
	# log line.
	#
	# The container's own healthcheck is such a client. It dials
	# https://127.0.0.1/, and busybox wget puts that literal into SNI rather
	# than omitting it the way curl and browsers do. Against a site named
	# anything other than 127.0.0.1 the handshake died, the proxy never went
	# healthy, and `up --wait` failed after two minutes against a Caddy that had
	# already logged "certificate obtained successfully".
	#
	# CI missed it for one reason: the smoke job set METACLAUDE_SITE=127.0.0.1,
	# so the probe's SNI happened to equal the site name. The site name is now
	# deliberately different there, which is what makes this line testable.
	fallback_sni {$METACLAUDE_SNI_DEFAULT:localhost}

	# Deliberately absent: `trusted_proxies`. Caddy is the edge here — there is
	# nothing in front of it — so it must not honour an X-Forwarded-For header a
	# client made up. Caddy's default is to trust none, which is correct; naming
	# ranges here would only create a way to lie about the client address, and
	# that address is what the login lockout counts against.

	servers {
		# HTTP/3 is worth having on a phone with a flaky connection, but it is
		# not always available: Chrome refuses to use QUIC against a certificate
		# signed by a locally-installed trust anchor, so under the `internal`
		# mode h3 is advertised, declined, and silently falls back to TCP.
		# Set METACLAUDE_PROTOCOLS="h1 h2" there to stop advertising it and to
		# leave the UDP port closed.
		protocols {$METACLAUDE_PROTOCOLS:h1 h2 h3}
	}
}

# Everything a site serves, minus its certificate. Two blocks import this: the
# address the owner types, and an optional second one.
#
# Why a second address at all. A deployment starts life reachable at a bare IP,
# under Caddy's own CA. The day a domain is pointed at it, switching
# METACLAUDE_SITE to the name moves the certificate — and the IP that was the
# only way in until that morning starts failing the handshake, because
# fallback_sni now hands it a certificate for the name. Losing the address you
# have been using as the price of gaining a name is a bad trade, and it is the
# one an operator makes without being warned.
#
# So METACLAUDE_ALT_SITE keeps the old address working under the internal CA
# while the name gets a publicly trusted certificate. It defaults to `localhost`,
# which is inert: the block always parses, and an unset variable adds nothing
# reachable from outside.
(site) {
	encode zstd gzip

	header {
		# Two years, subdomains included. A browser only records this over a
		# connection it already trusts, so under `tls internal` it takes effect
		# once the CA is installed and is inert before that.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# A private tool. Nothing here should ever be indexed.
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		-Server
	}

	# The WebSocket upgrade needs its own route so Caddy does not buffer it.
	@websocket {
		path /api/ws
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket app:8787

	reverse_proxy app:8787 {
		# An agent run can stream for a long time between tokens; the default
		# read timeout would cut a long tool call short.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
		level INFO
	}
}

{$METACLAUDE_SITE:localhost} {
	# Mounted by compose from docker/tls/<METACLAUDE_TLS_MODE>.caddy.
	# A snippet rather than `tls {$VAR}` because the ACME-on-IP mode needs a
	# block — `profile shortlived` is a subdirective of `issuer acme` — and
	# the Caddyfile has no conditionals.
	import /etc/caddy/tls.caddy
	import site
}

{$METACLAUDE_ALT_SITE:alt.metaclaude.invalid} {
	# Always the internal CA. This address exists precisely for the cases ACME
	# cannot serve — a bare IP, or a name that no longer resolves here.
	tls internal
	import site
}
