#!/usr/bin/env bash
#
# The only thing the CI key can do on this server.
#
# Installed as the forced command in the deploy account's authorized_keys:
#
#   restrict,command="/opt/metaclaude/bin/metaclaude-deploy" ssh-ed25519 AAAA…
#
# so whatever CI asks for arrives in $SSH_ORIGINAL_COMMAND and is parsed here
# rather than executed. That inversion is the whole security model: the key
# cannot open a shell, cannot forward a port, and cannot run a command this
# script does not recognise — even if GitHub's secret store leaks it.
#
# Grammar, and nothing else is accepted:
#
#   deploy <image-reference>   pull, switch, health-check, roll back on failure
#   rollback                   return to the previously healthy image
#   status                     what is running
#   health                     the health endpoint's own answer
#
# The image reference is checked against ALLOWED_IMAGE_PREFIX, so a stolen key
# cannot deploy an arbitrary image from an arbitrary registry.

set -Eeuo pipefail

APP_DIR="${METACLAUDE_APP_DIR:-/opt/metaclaude}"
RELEASES="$APP_DIR/releases"
CURRENT="$RELEASES/current"
PREVIOUS="$RELEASES/previous"
LOCK="$RELEASES/.lock"
# Written by this script, read by compose. Separate from .env so a deployment
# never touches the file holding the Claude token and the master key.
IMAGE_ENV="$RELEASES/.env.image"

# A stolen deploy key must not be able to point this host at someone else's
# image — so the allow-list is the exact repository, not merely the registry.
# `ghcr.io/` alone would let anyone with the key deploy any public GHCR image,
# which on a host whose deploy account is in the docker group is a root shell.
#
# Empty by default, and a deploy refuses while it is empty. There is no safe
# fallback to hard-code here: a literal repository would name whichever account
# this file was written for, so every other operator's server would ship with an
# allow-list pointing at a namespace they do not control. install-app.sh derives
# the real value from the checkout's own git remote and writes it into
# $APP_DIR/deploy.conf, which is root-owned and only readable by the deploy
# account — it must not be a file that account can edit.
ALLOWED_IMAGE_PREFIX="${ALLOWED_IMAGE_PREFIX:-}"

# How long the container gets to report healthy before it is judged a failure.
HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-180}"

# How many images of the pinned repository survive a deploy, newest first.
# Whatever `current` and `previous` resolve to is spared on top of this, so the
# rollback button always has a target — see prune_images().
IMAGE_KEEP="${IMAGE_KEEP:-3}"

# How long the proxy gets to complete a TLS handshake once compose calls it
# healthy. Separate from the above because it covers a different thing: not
# whether the container came up, but whether its certificate is usable yet.
PROXY_WAIT_SECONDS="${PROXY_WAIT_SECONDS:-60}"

# shellcheck source=/dev/null
[ -f "$APP_DIR/deploy.conf" ] && . "$APP_DIR/deploy.conf"

# After the file that may set it, and forgiving rather than fatal: a typo in a
# retention ceiling must not be able to block a deployment. It ends up on the
# right of `-le`, where a non-number is a bash error rather than a wrong answer.
case "$IMAGE_KEEP" in
  '' | *[!0-9]*) IMAGE_KEEP=3 ;;
  *) [ "$IMAGE_KEEP" -ge 1 ] || IMAGE_KEEP=1 ;;
esac

log()  { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }
die()  { printf '[%s] ERROR: %s\n' "$(date -u +%H:%M:%S)" "$*" >&2; exit 1; }

cd "$APP_DIR" 2>/dev/null || die "no $APP_DIR on this host"

# The other half of "is this host set up". A half-finished install is a real
# state to land in — provisioning can die between creating $APP_DIR and creating
# releases/ — and every verb needs the same answer. Without this, `deploy` fails
# as a bare redirection error naming a lock file nobody has heard of, and
# `status` cheerfully reports "(none recorded)", which reads as a set-up host
# that has simply never deployed.
[ -d "$RELEASES" ] || die \
  "$RELEASES is missing — this host is not fully set up; re-run deploy/install-app.sh"

# `compose()` passes --env-file "$IMAGE_ENV" on every call, and that file is
# written by `bring_up` — so on a host brought up by bootstrap.sh, which starts
# the stack with a plain `docker compose up -d`, it does not exist yet. Every
# verb that reaches compose then died with
#
#     couldn't find env file: .../releases/.env.image
#
# including `status`, which is precisely what deploy.yml tells an operator to
# run after a failed deploy. Creating it empty is enough: compose merges the
# files in order and an empty one contributes nothing, so the resolved image
# still comes from .env until the first real deploy records one.
[ -f "$IMAGE_ENV" ] || : > "$IMAGE_ENV"

# ─────────────────────────────────────────────────────────────────────────────
# Parse what CI asked for
# ─────────────────────────────────────────────────────────────────────────────

# Interactive use (an admin debugging) passes arguments; ssh passes the command
# in the environment. Never eval either.
REQUEST="${SSH_ORIGINAL_COMMAND:-$*}"
[ -n "$REQUEST" ] || die "no command. Try: deploy <image> | rollback | status | health"

# The whole request is matched against one grammar, before any splitting.
#
# Splitting first and looking only at the fields it cares about would mean
# `deploy <image> | sh` and `deploy <image>` + a second line both quietly become
# a plain deploy, with the tail dropped. Nothing would execute — this script
# never evaluates its input — but a forced command that silently discards the
# part of a request it does not understand is one refactor away from doing so.
# Refusing outright is the same three lines and does not decay.
#
# The separator is a literal space, not `[[:space:]]`.
#
# Bash's `=~` anchors to the whole string, so a request carrying a second
# *command* on a second line has never matched. But `[[:space:]]` also matches a
# newline, so `deploy\n<image>` did — harmlessly, since the image still had to
# clear the allow-list below, but the comment here used to claim that no
# multi-line request could match at all, and that was simply untrue. CI sends
# one space; narrowing the class costs nothing and makes the grammar mean what
# it says.
if [[ ! "$REQUEST" =~ ^(deploy +[A-Za-z0-9._/:@-]+|rollback|status|health)$ ]]; then
  die "refusing $(printf '%q' "$REQUEST") — expected: deploy <image> | rollback | status | health"
fi

read -r ACTION ARGUMENT _ <<<"$REQUEST"

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

# Both env files, always, and in this order: the operator's .env first, then
# the image this script chose. Later files win, so the deploy decides the image
# without ever rewriting the file the operator edits by hand.
compose() {
  docker compose --project-directory "$APP_DIR" \
    --env-file "$APP_DIR/.env" \
    --env-file "$IMAGE_ENV" "$@"
}

# Resolve a reference to the digest the registry actually served.
#
# A tag is a mutable pointer — GHCR has no immutability setting, and anything
# with write access can move `:latest` or even `sha-<commit>`. Recording a tag
# would mean "roll back" resolves to whatever that tag points at *now*, which
# is not what was running. The digest is the only stable name for an image.
resolve_digest() {
  docker inspect --format '{{index .RepoDigests 0}}' "$1" 2>/dev/null | head -1
}

# Docker's healthcheck runs inside the container, so it proves the process is
# up but not that the proxy in front of it is routing. This asks from outside —
# and asks more than once, because a single probe is not a health gate.
#
# Caddy starts listening before it has a certificate, so the first HTTPS request
# after `up` can fail with a TLS alert on a deployment that is entirely healthy —
# and this script's answer to a failed probe is to roll back, or to declare the
# service down when there is nothing to roll back to. That is the shape of a
# first deploy on a fresh server, where the local CA and the certificate are both
# being minted. compose.yml now health-gates the proxy on a real handshake, and
# this retries to a deadline as well: the two failure modes are independent.
proxy_answers() {
  local deadline=$(( SECONDS + PROXY_WAIT_SECONDS )) code
  while :; do
    code="$(curl -sS -o /dev/null -w '%{http_code}' -k --max-time 10 https://127.0.0.1/api/health 2>/dev/null || echo 000)"
    [ "$code" = "200" ] && return 0
    [ "$SECONDS" -ge "$deadline" ] && return 1
    sleep 2
  done
}

record() {
  install -d -m 0750 "$RELEASES"
  # Rotate on a deploy; never on a rollback.
  #
  # On a rollback the target *is* `previous`, so rotating files the image being
  # escaped as the next rollback target — and the second press of the button
  # reinstates the outage the first one ended. That is the button an operator
  # presses repeatedly, at the worst possible moment, precisely because they are
  # not sure it worked.
  #
  # Leaving `previous` alone makes a second rollback idempotent: it redeploys
  # the same known-good image.
  if [ "$ACTION" != "rollback" ] && [ -f "$CURRENT" ]; then
    cp "$CURRENT" "$PREVIOUS"
  fi
  printf '%s\n' "$1" > "$CURRENT"
}

bring_up() {
  local image="$1"
  printf 'METACLAUDE_IMAGE=%s\n' "$image" > "$IMAGE_ENV"
  # `--wait` blocks until every service is healthy and exits non-zero on
  # timeout. That is only as strong as the healthchecks themselves: the proxy
  # had none, so `--wait` returned as soon as its container was running and the
  # probe below could land before Caddy had a certificate. Both ends are fixed —
  # compose.yml health-gates the proxy on a real handshake, and proxy_answers
  # retries — but the gate is the healthcheck, so keep one on every service.
  compose up -d --remove-orphans --wait --wait-timeout "$HEALTH_TIMEOUT_SECONDS"
}

# ─────────────────────────────────────────────────────────────────────────────
# Read-only commands
# ─────────────────────────────────────────────────────────────────────────────

# compose.yml and the Caddyfile live on the server, not in the image — an image
# that supplied its own compose file could ask for a host mount and escape the
# very confinement that file exists to impose. The cost is that they can drift
# from the repository, so every run prints what it is actually using and CI
# compares. Changing them is an admin action: deploy/install-app.sh.
print_infra_digests() {
  for file in compose.yml docker/Caddyfile; do
    if [ -f "$APP_DIR/$file" ]; then
      printf '%s-sha256: %s\n' "$(basename "$file")" "$(sha256sum "$APP_DIR/$file" | cut -c1-16)"
    else
      printf '%s-sha256: MISSING\n' "$(basename "$file")"
    fi
  done
}

# Reclaim the disk a deploy fills, without ever removing what rollback needs.
#
# What shipped before was `docker image prune -f --filter 'until=168h'`. At
# several releases a day no image ever reaches seven days, so it removed
# nothing, ever — found on a real host at 97% full, 23 images and 19 GB, next
# to 15 GB of build cache on a box whose whole premise is that it never builds
# anything. An age is the wrong axis when the release cadence is faster than
# the age.
#
# So: cardinality, plus two names that are spared whatever their age. Both are
# resolved to image *ids* first, because `current` records a digest reference
# while the same image usually also wears a version tag — sparing the literal
# string would delete it under its other name and leave the rollback button
# with nothing, which is discovered during an incident.
#
# Removal is by reference rather than by id: an image keeps its layers until
# its last tag is gone, and `docker rmi <id>` refuses outright while more than
# one name points at it. Only an untagged image is addressed by id.
prune_images() {
  local spared="" doomed="" seen="" kept=0 listing ref_file ref id

  for ref_file in "$CURRENT" "$PREVIOUS"; do
    [ -f "$ref_file" ] || continue
    ref="$(cat "$ref_file" 2>/dev/null)" || continue
    [ -n "$ref" ] || continue
    id="$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null)" || continue
    spared="$spared$id "
  done

  listing="$(docker images --filter "reference=${ALLOWED_IMAGE_PREFIX}*" \
    --format '{{.CreatedAt}}	{{.ID}}	{{.Repository}}:{{.Tag}}' 2>/dev/null | sort -r)" || listing=""
  [ -n "$listing" ] || return 0

  # Newest first. One image can appear on several rows, once per tag, so the
  # ceiling counts distinct images rather than rows.
  #
  # The creation date is read into `_` rather than a name: `sort -r` above has
  # already done everything it is here for, and a named variable nothing reads
  # is a claim that something does.
  while IFS=$'\t' read -r _ id ref; do
    [ -n "$id" ] || continue
    case " $seen " in *" $id "*) continue ;; esac
    seen="$seen$id "
    kept=$((kept + 1))
    [ "$kept" -le "$IMAGE_KEEP" ] && continue
    case " $spared " in *" $id "*) continue ;; esac
    doomed="$doomed$id "
  done <<< "$listing"

  while IFS=$'\t' read -r _ id ref; do
    [ -n "$id" ] || continue
    case " $doomed " in *" $id "*) ;; *) continue ;; esac
    case "$ref" in
      *':<none>') docker rmi "$id" >/dev/null 2>&1 || true ;;
      *) docker rmi "$ref" >/dev/null 2>&1 || true ;;
    esac
  done <<< "$listing"

  # Nothing on this host builds — the deploy pipeline exists precisely so that
  # what runs here is the artefact CI tested — so any build cache is dead
  # weight. It was the single largest consumer on the host that filled up.
  docker builder prune -af >/dev/null 2>&1 || true

  # Dangling images have no repository at all, so the reference filter above
  # cannot see them and the loops never judge them. Without this they are the
  # one thing the old `image prune` did catch that the new one would not.
  # Untagged and unreferenced by definition: nothing can be spared by mistake.
  docker image prune -f >/dev/null 2>&1 || true

  [ -n "$doomed" ] && log "reclaimed $(printf '%s' "$doomed" | wc -w) image(s) and the build cache"
  return 0
}

if [ "$ACTION" = "status" ]; then
  printf 'current:  %s\n' "$( [ -f "$CURRENT" ] && cat "$CURRENT" || echo '(none recorded)')"
  printf 'previous: %s\n' "$( [ -f "$PREVIOUS" ] && cat "$PREVIOUS" || echo '(none recorded)')"
  print_infra_digests
  echo
  compose ps
  exit 0
fi

if [ "$ACTION" = "health" ]; then
  curl -sS -k --max-time 10 https://127.0.0.1/api/health || die "the health endpoint did not answer"
  echo
  exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
# Deploy and rollback
# ─────────────────────────────────────────────────────────────────────────────

# Two deploys at once would race on the same containers and leave the recorded
# image disagreeing with the running one. flock makes the second wait.
exec 9>"$LOCK"
flock -w 600 9 || die "another deployment is in progress and did not finish within 10 minutes"

if [ "$ACTION" = "rollback" ]; then
  [ -f "$PREVIOUS" ] || die "no previous release recorded; nothing to roll back to"
  TARGET="$(cat "$PREVIOUS")"
  log "rolling back to $TARGET"
else
  TARGET="$ARGUMENT"
  [ -n "$TARGET" ] || die "deploy needs an image reference"

  # Strict allow-list. Registry, path, and either a tag or a digest — nothing
  # that could be read as a flag, a path traversal or a second command.
  #
  # The separator is part of what is matched, and that is the whole point. A
  # bare `"$ALLOWED_IMAGE_PREFIX"*` also accepts a *different repository* whose
  # name merely begins with the allowed one — `…/metaclaude-evil:latest` sails
  # through — which on a host whose deploy account is in the docker group is
  # exactly the root shell this list exists to deny. Only `:tag` and `@digest`
  # continue the same repository.
  [ -n "$ALLOWED_IMAGE_PREFIX" ] || die \
    "no ALLOWED_IMAGE_PREFIX configured — run deploy/install-app.sh, or set it in $APP_DIR/deploy.conf"
  case "$TARGET" in
    "$ALLOWED_IMAGE_PREFIX":*|"$ALLOWED_IMAGE_PREFIX"@*) ;;
    *) die "refusing '$TARGET': images must be $ALLOWED_IMAGE_PREFIX with a :tag or @digest" ;;
  esac
  if ! printf '%s' "$TARGET" | grep -Eq '^[a-z0-9._/-]+(:[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$'; then
    die "refusing '$TARGET': not a well-formed image reference"
  fi
  log "deploying $TARGET"
fi

PRIOR="$( [ -f "$CURRENT" ] && cat "$CURRENT" || echo '')"

# Pull before switching anything, so a registry outage or a bad tag fails while
# the current version is still serving.
log "pulling"
docker pull --quiet "$TARGET" >/dev/null || die "could not pull $TARGET — nothing was changed"

# From here on, work with the digest rather than whatever was asked for. A
# rollback must return to the bytes that were running, not to wherever a
# mutable tag has since been moved.
if [ "$ACTION" != "rollback" ]; then
  DIGEST_REF="$(resolve_digest "$TARGET")"
  if [ -n "$DIGEST_REF" ]; then
    [ "$DIGEST_REF" != "$TARGET" ] && log "resolved to $DIGEST_REF"
    TARGET="$DIGEST_REF"
  else
    # A locally-built image has no RepoDigest. Deploying one is not the
    # supported path, but failing here would be worse than proceeding loudly.
    log "warning: $TARGET has no registry digest; recording the tag as given"
  fi
fi

record "$TARGET"

log "starting"
if ! bring_up "$TARGET"; then
  log "compose refused to start the new image"
  if [ -n "$PRIOR" ]; then
    log "restoring $PRIOR"
    printf '%s\n' "$PRIOR" > "$CURRENT"
    bring_up "$PRIOR" || true
  fi
  die "deployment failed at startup"
fi

if proxy_answers; then
  log "healthy, and answering through the proxy"
  print_infra_digests
  prune_images
  log "deployed $TARGET"
  exit 0
fi

# ── Automatic rollback ───────────────────────────────────────────────────────
# A deployment that is not serving is not a deployment. Going back is always
# safer than leaving a half-broken version up while someone reads the logs.
log "the new image is not serving"

if [ -z "$PRIOR" ] || [ "$PRIOR" = "$TARGET" ]; then
  compose logs --tail 60 app 2>&1 || true
  die "no earlier image to fall back to — the service is DOWN and needs attention"
fi

log "rolling back to $PRIOR"
printf '%s\n' "$PRIOR" > "$CURRENT"
if bring_up "$PRIOR"; then
  compose logs --tail 60 app 2>&1 || true
  die "deployment of $TARGET failed; rolled back to $PRIOR, which is healthy"
fi

compose logs --tail 60 app 2>&1 || true
die "deployment of $TARGET failed AND the rollback to $PRIOR did not come up — the service is DOWN"
